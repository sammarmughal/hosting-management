# Copy to .env and fill in. Never commit .env (docs/05 §10).

# Database: MySQL/MariaDB, used by the app and the migrations.
# Local development: the Docker database (`npm run db:up`, README → Local database).
# Production (docs/11 §1): mysql://u123456789_hrm:PASSWORD@localhost:3306/u123456789_hrm
#   - user and database as created in hPanel → Databases (with the account prefix)
#   - host localhost: the app and the database are on the same Hostinger server
#   - URL-encode special characters in the password (@ → %40, # → %23, / → %2F)
# The pool is capped at 5 connections in code (src/lib/db-config.ts),
# because shared hosting limits connections per database user.
DATABASE_URL="mysql://hrm:hrm@localhost:3306/hrm"
# Integration tests only (a separate, disposable database; wiped by the tests).
TEST_DATABASE_URL="mysql://hrm:hrm@localhost:3306/hrm_test"
# Playwright e2e (disposable; falls back to TEST_DATABASE_URL).
E2E_DATABASE_URL="mysql://hrm:hrm@localhost:3306/hrm_e2e"

APP_URL="https://renewals.abdulrehmaan.net"
# Encrypts TOTP secrets + the SMTP password. Generate: openssl rand -base64 32
APP_KEY="base64:…32 random bytes…"
SESSION_COOKIE_NAME="hrm_session"
TZ="Asia/Karachi"                       # informational; code never relies on process TZ

# Development only (ignored when NODE_ENV=production)
# "json" = nodemailer jsonTransport: nothing is sent, messages are logged.
# Leave empty (or "smtp") to use Settings → Email, e.g. Mailpit on localhost:1025.
MAIL_TRANSPORT=""
FAKE_TODAY=""                           # e.g. 2026-10-20
# Local runs of the production build only (npm start, e2e). NEVER set on a host:
# in production the server refuses to start unless APP_URL is the public https URL.
ALLOW_LOCAL_APP_URL=""
SEED_DEMO="0"

# Required in production: the daily check (/api/cron/check, called by an hPanel
# cron job with curl, docs/11 §4) must send "Authorization: Bearer <CRON_SECRET>".
# 32+ random characters: openssl rand -hex 32
CRON_SECRET=""

# Sign in with Google (docs/11 §2a). All three, or none (Google sign-in off).
# The OAuth client from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=""                     # …apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=""
# The only Google accounts that may sign in, comma-separated. Google sign-in
# skips our own 2FA: turn on 2-Step Verification on these Google accounts.
ADMIN_EMAILS="abdulrehmaan060@gmail.com"
# "0" turns off email + password sign-in (and password reset). Ignored
# unless Google sign-in is set up, so you can't lock yourself out.
PASSWORD_LOGIN_ENABLED="1"

# Header holding the visitor's IP (login throttling, /i/* rate limit).
# Default x-forwarded-for (first value). Verify after deploy: docs/11 §7.
TRUSTED_IP_HEADER=""
